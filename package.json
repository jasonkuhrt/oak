{
  "name": "molt",
  "repository": "git@github.com:jasonkuhrt/molt.git",
  "author": "Jason Kuhrt",
  "packageManager": "pnpm@8.15.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fix:format": "dprint fmt",
    "fix:lint": "oxlint --fix --fix-suggestions .",
    "check:format": "dprint check",
    "check:lint": "oxlint .",
    "check:types": "tsc --noEmit",
    "fixcheck": "pnpm run '/fix:.*/' && pnpm run '/check:.*/'",
    "check": "pnpm run '/check:.*/'",
    "fix": "pnpm run '/fix:.*/'",
    "release:@molt/command": "pnpm release --package @molt/command",
    "release:molt": "pnpm release --package molt",
    "release": "tsx scripts/release.ts"
  },
  "devDependencies": {
    "@octokit/core": "^5.0.1",
    "@swc/core": "1.3.94",
    "@tsconfig/node-lts": "^22.0.2",
    "@tsconfig/recommended": "1.0.3",
    "@tsconfig/strictest": "^2.0.6",
    "@types/node": "20.8.7",
    "@types/semver": "^7.5.4",
    "execa": "8.0.1",
    "fast-glob": "3.3.1",
    "fs-jetpack": "5.1.0",
    "markdown-toc": "^1.2.0",
    "nodemon": "^3.0.1",
    "oxlint": "^1.19.0",
    "semver": "^7.5.4",
    "semver-regex": "4.0.5",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "0.34.6",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "alge": "0.8.1"
  }
}
