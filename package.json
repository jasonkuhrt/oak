{
  "name": "@wollybeard/oak",
  "version": "0.9.0",
  "description": "Type-safe CLI command definition and execution.",
  "repository": "git@github.com:jasonkuhrt/oak.git",
  "bugs": "https://github.com/jasonkuhrt/oak/issues",
  "homepage": "https://github.com/jasonkuhrt/oak#readme",
  "author": "Jason Kuhrt",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@8.15.2",
  "files": [
    "src",
    "build"
  ],
  "exports": {
    ".": "./build/_entrypoints/_.js",
    "./types": "./build/_entrypoints/types.js",
    "./extensions": "./build/_entrypoints/extensions.js"
  },
  "scripts": {
    "vitest": "vitest",
    "test": "vitest",
    "build": "tsc --build tsconfig.build.json",
    "build:toc": "markdown-toc README.md -i --maxdepth 4 && dprint fmt README.md",
    "clean": "tsc --build --clean",
    "prepublishOnly": "pnpm build",
    "fix:format": "dprint fmt",
    "fix:lint": "oxlint --fix --fix-suggestions .",
    "check:format": "dprint check",
    "check:lint": "oxlint .",
    "check:types": "tsc --noEmit",
    "fixcheck": "pnpm run '/fix:.*/' && pnpm run '/check:.*/'",
    "check": "pnpm run '/check:.*/'",
    "fix": "pnpm run '/fix:.*/'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "examples:intro": "tsx examples/intro-zod.ts",
    "examples:intro-zod": "tsx examples/intro-zod.ts",
    "examples:intro-effect": "tsx examples/intro-effect.ts",
    "examples:optional-effect": "tsx examples/optional-effect.ts",
    "examples:prompt": "tsx examples/prompt.ts",
    "examples:kitchen-sink": "tsx examples/kitchen-sink.ts",
    "examples:publish": "tsx examples/publish.ts"
  },
  "keywords": [],
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@wollybeard/kit": "^0.102.0",
    "alge": "0.8.1",
    "ansi-escapes": "^7.2.0",
    "chalk": "^5.6.2",
    "effect": "^3.19.3",
    "jasonkuhrt": "link:..",
    "string-length": "^6.0.0",
    "strip-ansi": "^7.1.2"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@octokit/core": "^7.0.6",
    "@shikijs/transformers": "^3.15.0",
    "@shikijs/vitepress-twoslash": "^3.15.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/strictest": "^2.0.7",
    "@types/node": "24.10.0",
    "@types/semver": "^7.7.1",
    "execa": "9.6.0",
    "fast-glob": "3.3.3",
    "fs-jetpack": "5.1.0",
    "markdown-toc": "^1.2.0",
    "oxlint": "^1.28.0",
    "semver": "^7.7.3",
    "semver-regex": "4.0.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.8",
    "zod": "^4.1.12"
  }
}
