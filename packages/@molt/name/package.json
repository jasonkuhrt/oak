{
  "name": "@molt/name",
  "version": "0.2.0",
  "description": "Advanced Types for parsing CLI flags and more.",
  "scripts": {
    "clean": "tsc --build tsconfig.build.json --clean",
    "check:types": "tsc --noEmit",
    "build": "pnpm clean && tsc --project tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "type": "module",
  "files": [
    "src",
    "build"
  ],
  "types": "./build/_entrypoints/default.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/_entrypoints/default.d.ts",
        "default": "./build/_entrypoints/default.js"
      }
    }
  },
  "keywords": [],
  "author": "Jason Kuhrt",
  "license": "MIT",
  "devDependencies": {
    "conditional-type-checks": "1.0.6",
    "tsd": "0.29.0"
  },
  "dependencies": {
    "@types/lodash.camelcase": "4.3.9",
    "hotscript": "^1.0.13",
    "lodash.camelcase": "^4.3.0"
  }
}
