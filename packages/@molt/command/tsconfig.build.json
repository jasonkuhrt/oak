{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "src",
    "tsBuildInfoFile": "node_modules/.cache/build.tsbuildinfo",
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": ["**/*.spec.*", "**/*.test.*"]
}
