{
  "name": "@molt/command",
  "version": "0.9.0",
  "description": "Type-safe CLI command definition and execution.",
  "type": "module",
  "scripts": {
    "vitest": "vitest",
    "check:types": "tsc --noEmit",
    "test": "vitest",
    "clean": "tsc --build --clean",
    "build": "tsc --build tsconfig.build.json",
    "build:toc": "markdown-toc README.md -i --maxdepth 4 && dprint fmt README.md",
    "prepublishOnly": "pnpm build",
    "examples:intro": "tsx examples/intro.ts",
    "examples:prompt": "tsx examples/prompt.ts",
    "examples:kitchen-sink": "tsx examples/kitchen-sink.ts",
    "examples:publish": "tsx examples/publish.ts"
  },
  "files": [
    "src",
    "build"
  ],
  "exports": {
    ".": "./build/_entrypoints/default.js",
    "./types": "./build/_entrypoints/types.js",
    "./extensions": "./build/_entrypoints/extensions.js"
  },
  "keywords": [],
  "author": "Jason Kuhrt",
  "license": "MIT",
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@wollybeard/kit": "^0.78.0",
    "alge": "0.8.1",
    "ansi-escapes": "^6.2.0",
    "chalk": "^5.3.0",
    "effect": "^3.18.4",
    "string-length": "^6.0.0",
    "strip-ansi": "^7.1.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "execa": "8.0.1",
    "fast-glob": "3.3.1",
    "fs-jetpack": "5.1.0",
    "vitest": "^3.2.4",
    "vitest-mock-process": "^1.0.4",
    "zod": "^4.0.0"
  }
}
